# mere-fusion environment variables
# Copy to .env and fill in your own keys. Never commit .env.

# ── LLM ──────────────────────────────────────────────────
# OpenAI (ChatGPT path)
OPENAI_API_KEY=

# DeepSeek-V4 (recommended LLM, model deepseek-v4-flash)
DEEPSEEK_API_KEY=

# ── Multimodal vision (Qwen-VL, replaces YOLO+DeepFace+OCR) ─
DASHSCOPE_API_KEY=

# ── Avatar (offline half-body video) ─────────────────────
# Path to a local clone of antgroup/echomimic_v3 (for --avatar echomimic)
ECHOMIMIC_V3_DIR=

# ── Doubao / Volcengine voice (optional high-end ASR/TTS/Realtime) ─
DOUBAO_APPID=
DOUBAO_ACCESS_TOKEN=

# ── Optional: tooling ────────────────────────────────────
# Explicit ffmpeg path (only if ffmpeg is not on PATH)
FFMPEG_PATH=

# HuggingFace mirror (useful in mainland China)
HF_ENDPOINT=https://hf-mirror.com

# ── SRS / WebRTC ─────────────────────────────────────────
# WebRTC candidate IP. 127.0.0.1 for same-machine; public IP for remote.
SRS_CANDIDATE=127.0.0.1

# ── Proxy (only if you need one for overseas APIs) ───────
# Leave empty to disable.
HTTP_PROXY=
HTTPS_PROXY=
