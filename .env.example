# mere-fusion environment variables
# Copy to .env and fill in your own keys. Never commit .env.

# ── LLM ──────────────────────────────────────────────────
# OpenAI (ChatGPT path)
OPENAI_API_KEY=

# ── Optional: tooling ────────────────────────────────────
# Explicit ffmpeg path (only if ffmpeg is not on PATH)
FFMPEG_PATH=

# HuggingFace mirror (useful in mainland China)
HF_ENDPOINT=https://hf-mirror.com

# ── SRS / WebRTC ─────────────────────────────────────────
# WebRTC candidate IP. 127.0.0.1 for same-machine; public IP for remote.
SRS_CANDIDATE=127.0.0.1

# ── Proxy (only if you need one for overseas APIs) ───────
# Leave empty to disable.
HTTP_PROXY=
HTTPS_PROXY=
